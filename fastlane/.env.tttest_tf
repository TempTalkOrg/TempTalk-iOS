MATCH_SIGNALSHAREEXTENSION_PRFILE="match AppStore ${MATCH_SIGNALSHAREEXTENSION_IDENTIFIER}"
MATCH_NSE_IDENTIFIER='org.difft.chativetest.NSE'
MATCH_NSE_PRFILE="match AppStore ${MATCH_NSE_IDENTIFIER}"

# Apple
MANAGE_APP_VERSION_AND_BUILD_NUMBER='true'
