# Project Config
SCHEME='TempTalk'
PROJECT='Difft.xcodeproj'
INFO_PLIST_PATH='TempTalk/chative-Info.plist'
APPCONFIG_PLIST_PATH='TempTalk/AppConfig.plist'
GOOGLE_INFO_PLIST_PATH='TempTalk/GoogleService-Info-chative.plist'
CONFIGURATION='Release_test'

METHOD_TYPE='appstore'
MATCH_APP_IDENTIFIER='org.difft.chativetest'
MATCH_APP_PRFILE="match AppStore ${MATCH_APP_IDENTIFIER}"
