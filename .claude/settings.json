{
  "includeGitInstructions": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/allow-project-scripts.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-bash-patterns.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-read-image-validator.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(docs/claude/**)",
      "Edit(tmp/**)",
      "Write(docs/claude/**)",
      "Write(tmp/**)",
      "Bash(bundle:*)",
      "Bash(pod:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(simctl:*)",
      "Bash(PID=:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clean:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git rm:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git -C:*)",
      "Bash(git worktree:*)",
      "Bash(chmod +x:*)",
      "Bash(git stash)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git tag:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh label:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh search:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status)",
      "Bash(cp:*)",
      "Bash(df:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(unzip:*)",
      "Bash(rm -f tmp/:*)",
      "Bash(rm -f ./tmp/:*)",
      "Bash(rm -rf tmp/:*)",
      "Bash(rm -rf ./tmp/:*)",
      "Bash(awk:*)",
      "Bash(comm:*)",
      "Bash(cut:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tr:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(base64:*)",
      "Bash(xargs:*)",
      "Bash(curl:*)",
      "Bash(date:*)",
      "Bash(for:*)",
      "Bash(pandoc:*)",
      "Bash(sha256sum:*)",
      "Bash(shasum:*)",
      "Bash(wget:*)",
      "Bash(test:*)",
      "Bash([:*)",
      "Bash(./.claude/scripts/copy-to-clipboard.sh:*)",
      "Bash(./.claude/scripts/figma-asset-download.sh:*)",
      "Bash(${CLAUDE_SKILL_DIR}/scripts/wait-insider-builds.sh:*)",
      "Bash(make:*)",
      "Bash(python3 .claude/skills/query-crashlytics/parse-crashlytics.py*)",
      "Bash(python3 .claude/skills/video-frames/scripts/extract_frames.py *)",
      "WebFetch",
      "WebSearch",
      "mcp__plugin_figma_figma__*",
      "mcp__ide__getDiagnostics",
      "mcp__mobile-mcp__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_firebase_firebase__*",
      "mcp__markitdown__convert_to_markdown",
      "mcp__apple-docs__*",
      "Skill(firebase-context)",
      "Skill(infra-improve)",
      "Skill(infra-improve:*)",
      "Skill(code-review:code-review)",
      "Skill(analyze-bug)",
      "Skill(analyze-bug:*)",
      "Skill(analyze-feature)",
      "Skill(analyze-feature:*)",
      "Skill(design-code)",
      "Skill(design-code:*)",
      "Skill(implement-code)",
      "Skill(implement-code:*)",
      "Skill(create-pr)",
      "Skill(create-pr:*)",
      "Skill(explore-codebase)",
      "Skill(pr-manage:*)"
    ],
    "deny": [
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(cat >*)",
      "Bash(cat>*)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  }
}
