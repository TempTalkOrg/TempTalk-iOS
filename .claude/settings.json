{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/allow-project-scripts.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-bash-patterns.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit(docs/claude/**)",
      "Write(docs/claude/**)",
      "Bash(bundle:*)",
      "Bash(pod:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(simctl:*)",
      "Bash(PID=:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git clean:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git remote:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(git rm:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git -C:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git tag:*)",
      "Bash(gh api:*)",
      "Bash(gh issue:*)",
      "Bash(gh label:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(cp:*)",
      "Bash(df:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(unzip:*)",
      "Bash(rm -f tmp/:*)",
      "Bash(rm -f ./tmp/:*)",
      "Bash(rm -rf tmp/:*)",
      "Bash(rm -rf ./tmp/:*)",
      "Bash(awk:*)",
      "Bash(comm:*)",
      "Bash(cut:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(tr:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(curl:*)",
      "Bash(date:*)",
      "Bash(for:*)",
      "Bash(pandoc:*)",
      "Bash(sha256sum:*)",
      "Bash(shasum:*)",
      "Bash(wget:*)",
      "Bash(test:*)",
      "Bash([:*)",
      "Bash(./.claude/scripts/copy-to-clipboard.sh:*)",
      "Bash(${CLAUDE_SKILL_DIR}/scripts/wait-insider-builds.sh:*)",
      "Bash(python3 .claude/skills/query-crashlytics/parse-crashlytics.py*)",
      "WebFetch",
      "WebSearch",
      "mcp__figma__get_screenshot",
      "mcp__figma__get_design_context",
      "mcp__figma__get_metadata",
      "mcp__figma__whoami",
      "mcp__figma__download_figma_images",
      "mcp__figma__get_figma_data",
      "mcp__ide__getDiagnostics",
      "mcp__mobile-mcp__mobile_take_screenshot",
      "mcp__mobile-mcp__mobile_list_available_devices",
      "mcp__mobile-mcp__mobile_use_device",
      "mcp__mobile-mcp__mobile_launch_app",
      "mcp__mobile-mcp__mobile_list_elements_on_screen",
      "mcp__mobile-mcp__mobile_press_button",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__plugin_firebase_firebase__firebase_login",
      "mcp__plugin_firebase_firebase__firebase_logout",
      "mcp__plugin_firebase_firebase__firebase_get_project",
      "mcp__plugin_firebase_firebase__firebase_list_apps",
      "mcp__plugin_firebase_firebase__firebase_list_projects",
      "mcp__plugin_firebase_firebase__firebase_get_sdk_config",
      "mcp__plugin_firebase_firebase__firebase_get_environment",
      "mcp__plugin_firebase_firebase__firebase_update_environment",
      "mcp__plugin_firebase_firebase__firebase_init",
      "mcp__plugin_firebase_firebase__firebase_get_security_rules",
      "mcp__plugin_firebase_firebase__firebase_read_resources",
      "mcp__plugin_firebase_firebase__crashlytics_create_note",
      "mcp__plugin_firebase_firebase__crashlytics_delete_note",
      "mcp__plugin_firebase_firebase__crashlytics_get_issue",
      "mcp__plugin_firebase_firebase__crashlytics_list_events",
      "mcp__plugin_firebase_firebase__crashlytics_batch_get_events",
      "mcp__plugin_firebase_firebase__crashlytics_list_notes",
      "mcp__plugin_firebase_firebase__crashlytics_get_report",
      "mcp__plugin_firebase_firebase__crashlytics_update_issue",
      "mcp__markitdown__convert_to_markdown",
      "Skill(firebase-context)",
      "Skill(monday-tasks)",
      "mcp__monday__search",
      "mcp__monday__get_board_info",
      "mcp__monday__get_board_items_page",
      "mcp__monday__get_board_activity",
      "mcp__monday__get_form",
      "mcp__monday__get_graphql_schema",
      "mcp__monday__get_type_details",
      "mcp__monday__get_column_type_info",
      "mcp__monday__read_docs",
      "mcp__monday__list_users_and_teams",
      "mcp__monday__list_workspaces",
      "mcp__monday__workspace_info",
      "mcp__monday__get_monday_dev_sprints_boards",
      "mcp__monday__get_sprints_metadata",
      "mcp__monday__get_sprint_summary",
      "mcp__monday__board_insights",
      "mcp__monday__all_widgets_schema"
    ],
    "deny": [
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "firebase@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  }
}
